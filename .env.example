# Environment variables — copy to `.env` (gitignored) and fill in the values.
# NEVER commit `.env` or real values. Keep this file the up-to-date list of
# every key the project reads: add new variables here as they land.

# --- Site address ---
# The public origin of the site: canonical, sitemap, robots.txt, OG and JSON-LD
# all derive from it. Read from the PROCESS environment, not from `.env`:
# astro.config.mjs is evaluated before Astro loads `.env`, so a value written
# there would split `site` from the pages. Set it on Vercel (Production, and
# Preview too) or export it in the shell for a local build. Unset → the
# template placeholder https://example.com, which the deploy job refuses.
# While its host is *.vercel.app the site is a STAGING site: emails go only to
# STAGING_EMAIL_RECIPIENTS and nothing is written to the Brevo contact list.
# Moving to the real domain is changing this value and redeploying.
# SITE_URL="https://<project>.vercel.app"

# --- Contact form / Brevo ---
# Brevo API key — server-only SECRET. Without it the contact action no-ops in
# dev (the form "succeeds", nothing is sent) and refuses explicitly in
# production instead of silently dropping the lead. Set it in the deploy
# provider's project settings, never in git.
# BREVO_API_KEY=

# Email sender (verify the domain's DKIM/SPF/DMARC before go-live):
# CONTACT_FROM_EMAIL="no-reply@example.com"
# CONTACT_FROM_NAME="<PROJECT_NAME>"

# Where contact notifications land:
# CONTACT_TO_EMAIL="info@example.com"

# Staging only (SITE_URL on *.vercel.app): the only recipients that receive
# emails, comma-separated — full addresses, or domains with or without the @.
# Everyone else is dropped with a [brevo] log, and the form still succeeds.
# Unset on a staging site → no email leaves at all. Server-only SECRET: these
# are people's addresses, kept out of the build output.
# STAGING_EMAIL_RECIPIENTS="tester@agency.it,@example.org"

# --- Consent + analytics (iubenda CMP + Google Tag Manager) ---
# All of them are PUBLIC ids, not secrets: they ship in the client bundle. On
# Vercel create them as Plain variables, never Sensitive — a Sensitive var
# reaches a prebuilt build as the literal string [SENSITIVE], which the code
# then refuses as a non-numeric id (src/lib/analytics/tracking.ts,
# src/lib/legal/policy-id.ts).
#
# Gated as a set: without BOTH the GTM container and the iubenda site id,
# nothing is emitted — no banner, no tags, no non-essential cookie. Leave them
# unset until the client has an actual iubenda account and GTM container.
# PUBLIC_GTM_ID="GTM-XXXXXXX"
# PUBLIC_IUBENDA_SITE_ID=
# PUBLIC_IUBENDA_COOKIE_POLICY_ID=
# iubenda issues one policy id per language: the one above is the default locale's.
# PUBLIC_IUBENDA_COOKIE_POLICY_IDS="en:12345678,de:87654321"

# --- Abuse protection / Vercel BotID ---
# Not a secret, and NOT a kill switch for the check: BotID classifies either
# way, this only decides what happens to a request it calls a bot. Unset/false →
# observe mode (the verdict is logged, the submission goes through); true →
# reject with an ActionError. Defaults to false until a real browser submit has
# been seen passing on a deploy — a false positive silently costs a lead. Create
# it as a Plain variable on Vercel, never Sensitive (the build reads env at
# `vercel pull` time).
# BOTID_ENFORCE=false
