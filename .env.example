# Si copia in `.env`, che è gitignored, e si compila: qui c'è ogni chiave che il progetto legge.

# Si legge dall'ambiente del processo, non da `.env`: Astro valuta astro.config.mjs prima di
# caricarlo (docs/guides/deploy-ops.md § Variabili d'ambiente).
# SITE_URL="https://<project>.vercel.app"

# Form di contatto, via Brevo. Su Vercel la chiave si crea Plain: una Sensitive arriva alla
# funzione del deploy di release come la stringa letterale `[SENSITIVE]`.
# BREVO_API_KEY=
# CONTACT_FROM_EMAIL="no-reply@example.com"
# CONTACT_FROM_NAME="<PROJECT_NAME>"
# CONTACT_TO_EMAIL="info@example.com"

# Segreto solo lato server: porta gli indirizzi delle persone.
# STAGING_EMAIL_RECIPIENTS="tester@agency.it,@example.org"

# Consenso e analisi, iubenda e Google Tag Manager: id pubblici, che su Vercel si creano Plain.
# PUBLIC_GTM_ID="GTM-XXXXXXX"
# PUBLIC_IUBENDA_SITE_ID=
# PUBLIC_IUBENDA_COOKIE_POLICY_ID=
# iubenda emette un id di policy per lingua: quello sopra è della lingua predefinita.
# PUBLIC_IUBENDA_COOKIE_POLICY_IDS="en:12345678,de:87654321"

# Vercel BotID. Su Vercel si crea Plain; quando passarla a `true` lo dice
# docs/guides/forms-email.md § Protezione dagli abusi.
# BOTID_ENFORCE=false
