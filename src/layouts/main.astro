---
import { i18n } from 'astro:config/client'
import { ClientRouter } from 'astro:transitions'

import Head from '@/components/head/head.astro'
import JsFlag from '@/components/head/js-flag.astro'
import ThemeScript from '@/components/head/theme-script.astro'
import Tracking from '@/components/head/tracking.astro'
import Footer from '@/components/layout/footer.astro'
import Header from '@/components/layout/header.astro'
import SkipLink from '@/components/layout/skip-link.astro'

import '@/styles/globals.css'

interface Props {
  title: string
  absoluteTitle?: boolean
  description?: string
  canonicalPath?: string
  ogImage?: string
  jsonLd?: Record<string, unknown>[]
  // Solo pagine prerenderizzate, al contrario di NOINDEX_PATHS in src/middleware.ts:
  // va accompagnato dal `filter` della sitemap in astro.config.mjs.
  noindex?: boolean
  heroOverlay?: boolean
  overlayChrome?: 'auto' | 'light'
}

const {
  title,
  absoluteTitle,
  description,
  canonicalPath,
  ogImage,
  jsonLd,
  noindex,
  heroOverlay = false,
  overlayChrome = 'auto',
} = Astro.props
const lang = Astro.currentLocale ?? i18n?.defaultLocale ?? 'it'
---

<!doctype html>
{/* scroll-pt-20: i salti agli ancoraggi atterrano sotto l'header appiccicato da 64px */}
<html lang={lang} class="scroll-pt-20">
  <head>
    {/* La dichiarazione di codifica deve stare entro i primi 1024 byte del documento, e
        lo script inline del tema qui sotto la spingerebbe oltre. */}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <JsFlag />
    <ThemeScript />
    <Head {title} {absoluteTitle} {description} {canonicalPath} {ogImage} {jsonLd} {noindex} />
    <Tracking />
    <ClientRouter />
  </head>
  <body class="flex min-h-svh flex-col">
    <SkipLink />
    <Header heroOverlay={heroOverlay} overlayChrome={overlayChrome} />
    {/* tabindex=-1: lo skip-link deve muovere il focus vero, non solo il punto di partenza del Tab */}
    <main id="main-content" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  import { bindRouteFocus } from '@/lib/a11y/route-focus'

  bindRouteFocus()
</script>
