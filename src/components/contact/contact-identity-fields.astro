---
import { fieldErrorAttributes } from '@/components/forms/field-errors'
import { Field, FieldError, FieldLabel } from '@/components/ui/field'
import Input from '@/components/ui/input.astro'

import { useTranslations } from '@/i18n/translate'

const t = useTranslations(Astro.currentLocale)
---

<div class="grid gap-4 sm:grid-cols-2">
  <Field>
    <FieldLabel for="firstName" required>{t('contact.firstName')}</FieldLabel>
    <Input
      id="firstName"
      type="text"
      name="firstName"
      autocomplete="given-name"
      maxlength="100"
      required
      {...fieldErrorAttributes('firstName')}
    />
    <FieldError field="firstName" />
  </Field>
  <Field>
    <FieldLabel for="lastName" required>{t('contact.lastName')}</FieldLabel>
    <Input
      id="lastName"
      type="text"
      name="lastName"
      autocomplete="family-name"
      maxlength="100"
      required
      {...fieldErrorAttributes('lastName')}
    />
    <FieldError field="lastName" />
  </Field>
</div>

<Field>
  <FieldLabel for="email" required>{t('contact.email')}</FieldLabel>
  <Input
    id="email"
    type="email"
    name="email"
    autocomplete="email"
    spellcheck="false"
    autocapitalize="none"
    maxlength="254"
    required
    {...fieldErrorAttributes('email')}
  />
  <FieldError field="email" />
</Field>
