---
import { fieldErrorAttributes } from '@/components/forms/field-errors'
import { Field, FieldContent, FieldError, FieldLabel } from '@/components/ui/field'

import { localizedHref } from '@/i18n/href'
import { useTranslations } from '@/i18n/translate'

const t = useTranslations(Astro.currentLocale)
---

<Field orientation="horizontal">
  <label class="relative isolate mt-0.5 flex size-4 shrink-0 after:absolute after:-inset-1 after:-z-10">
    <input
      id="consent"
      type="checkbox"
      name="consent"
      required
      class="m-0 size-4 accent-primary"
      {...fieldErrorAttributes('consent')}
    />
  </label>
  <FieldContent>
    <FieldLabel for="consent" required class="block font-normal text-muted-foreground text-xs leading-relaxed">
      {t('contact.consent')}{' '}
      <a
        href={localizedHref(Astro.currentLocale, '/privacy')}
        class="focus-ring text-foreground underline underline-offset-4">{t('contact.privacyPolicy')}</a>.
    </FieldLabel>
    <FieldError field="consent" />
  </FieldContent>
</Field>
