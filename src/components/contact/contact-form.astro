---
import Button from '@/components/ui/button.astro'
import { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from '@/components/ui/card'

import { useTranslations } from '@/i18n/translate'

import ContactFormFields from './contact-form-fields.astro'

const t = useTranslations(Astro.currentLocale)
---

<Card class="p-6 sm:p-8">
  <CardHeader>
    <CardTitle as="h2" class="text-2xl">{t('contact.formTitle')}</CardTitle>
    <CardDescription as="p">{t('contact.formIntro')}</CardDescription>
  </CardHeader>

  {/* novalidate: i fumetti del browser segnalano prima che lo schema giri e non impostano
      aria-invalid — il gate unico è src/lib/contact.ts. */}
  <form
    novalidate
    method="post"
    data-contact-form
    data-i18n-sending={t('contact.sending')}
    data-i18n-submit={t('contact.submit')}
    data-i18n-generic-error={t('contact.genericFieldError')}
  >
    <CardContent class="flex flex-col gap-4 pt-6">
      <ContactFormFields />
    </CardContent>

    <CardFooter class="flex flex-col gap-3 pt-2">
      <p data-form-success role="status" class="hidden w-full font-medium text-success text-sm">
        {t('contact.success')}
      </p>
      <p data-form-error role="alert" class="hidden w-full font-medium text-destructive text-sm">
        {t('contact.error')}
      </p>

      <noscript>
        <p class="w-full text-muted-foreground text-sm">{t('contact.noscript')}</p>
      </noscript>
      <Button type="submit" class="w-full" disabled>{t('contact.submit')}</Button>
    </CardFooter>
  </form>
</Card>

<script>
  import { initFormBotId } from '@/components/forms/botid'

  import { bindContactForm } from './contact-form-behavior'

  initFormBotId()
  bindContactForm()
</script>
