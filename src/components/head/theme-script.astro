<script is:inline>
  function syncThemeToggles() {
    const dark = document.documentElement.classList.contains('dark')
    const toggles = document.querySelectorAll('[data-theme-toggle]')
    for (const toggle of toggles) {
      toggle.setAttribute('aria-pressed', dark ? 'true' : 'false')
    }
  }

  function applyTheme() {
    let stored = null
    try {
      stored = localStorage.getItem('theme')
    } catch {}
    const dark = stored
      ? stored === 'dark'
      : window.matchMedia('(prefers-color-scheme: dark)').matches
    document.documentElement.classList.toggle('dark', dark)
    syncThemeToggles()
    syncThemeColor(dark)
  }

  // Un meta theme-color vale solo mentre il suo `media` fa match: `not all` lo spegne.
  function syncThemeColor(dark) {
    const metas = document.querySelectorAll('meta[name="theme-color"][data-scheme]')
    for (const meta of metas) {
      const isDarkMeta = meta.getAttribute('data-scheme') === 'dark'
      meta.setAttribute('media', isDarkMeta === dark ? 'all' : 'not all')
    }
  }

  function syncFromDom() {
    syncThemeToggles()
    syncThemeColor(document.documentElement.classList.contains('dark'))
  }

  applyTheme()

  if (!window.__themeInit) {
    window.__themeInit = true
    document.addEventListener('DOMContentLoaded', syncFromDom)
    document.addEventListener('astro:after-swap', applyTheme)
    document.addEventListener('click', function (event) {
      const target = event.target
      const toggle = target && target.closest && target.closest('[data-theme-toggle]')
      if (!toggle) return
      const isDark = document.documentElement.classList.toggle('dark')
      syncThemeToggles()
      syncThemeColor(isDark)
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light')
      } catch {}
    })
  }
</script>
