<script is:inline>
  function markJs() {
    document.documentElement.classList.add('js')
  }
  markJs()
  // Le view transition non rieseguono gli script inline sulla pagina in arrivo.
  document.addEventListener('astro:after-swap', markJs)
  // lib/motion/reveal.ts imposta `data-reveal-active` appena gira; se quel chunk non arriva
  // mai, il contenuto resta invisibile senza nessun errore.
  setTimeout(function () {
    if (!document.documentElement.hasAttribute('data-reveal-active')) {
      document.documentElement.classList.add('reveal-failsafe')
    }
  }, 3000)
</script>
