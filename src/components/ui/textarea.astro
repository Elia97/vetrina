---
import type { HTMLAttributes } from 'astro/types'

import { cn } from '@/lib/utils'

type Props = HTMLAttributes<'textarea'>

// <textarea> non ha attributo value: il valore si renderizza come contenuto dell'elemento.
const { class: className, value, ...rest } = Astro.props
---

<textarea
  class={cn(
    'field-text flex min-h-20 w-full rounded-md border border-input bg-background px-3 py-2 placeholder:text-muted-foreground focus-visible:border-(--field-focus-border-color) focus-visible:shadow-(--field-focus-shadow) focus-visible:outline-hidden disabled:cursor-not-allowed disabled:opacity-50',
    className,
  )}
  {...rest}>{value != null ? value : <slot />}</textarea>
