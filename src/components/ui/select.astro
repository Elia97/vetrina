---
import type { HTMLAttributes } from 'astro/types'

import { cn } from '@/lib/utils'

import SelectListbox from './select-listbox.astro'
import SelectNative from './select-native.astro'
import SelectTrigger from './select-trigger.astro'

interface SelectOption {
  value: string
  label: string
}

interface Props extends HTMLAttributes<'select'> {
  options: SelectOption[]
  placeholder?: string
  value?: string | undefined
}

const { class: className, options, placeholder, value, ...rest } = Astro.props
const current = options.find((option) => option.value === value)

const triggerClasses = cn(
  'field-text h-(--field-height) w-full items-center justify-between gap-2 rounded-md border border-input bg-background px-3 py-2 focus-visible:border-(--field-focus-border-color) focus-visible:shadow-(--field-focus-shadow) focus-visible:outline-hidden disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-destructive',
  className,
)
---

<div class="relative" data-select-root>
  <SelectNative options={options} placeholder={placeholder} current={current} triggerClasses={triggerClasses} {...rest} />

  <SelectTrigger options={options} placeholder={placeholder} current={current} triggerClasses={triggerClasses} />

  <SelectListbox options={options} />
</div>

<script>
  import { bindSelects } from './select-behavior'

  bindSelects()
</script>
