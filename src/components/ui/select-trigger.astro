---
import { ChevronDown } from '@lucide/astro'

import { cn } from '@/lib/utils'

interface SelectOption {
  value: string
  label: string
}

interface Props {
  options: SelectOption[]
  placeholder?: string | undefined
  current?: SelectOption | undefined
  triggerClasses: string
}

const { options, placeholder, current, triggerClasses } = Astro.props
---

<button type="button" data-select-trigger aria-haspopup="listbox" aria-expanded="false" class={cn(triggerClasses, 'hidden')}>
  <span data-select-value class={cn('truncate', !current && 'text-muted-foreground')}>
    {current?.label ?? placeholder ?? options[0]?.label}
  </span>
  <ChevronDown stroke-width={1} class="size-4 shrink-0 text-muted-foreground" />
</button>
