---
import type { HTMLAttributes } from 'astro/types'
import { cva, type VariantProps } from 'class-variance-authority'

import { cn } from '@/lib/utils'

export const headingVariants = cva('text-balance', {
  variants: {
    size: {
      display: 'type-heading-display text-4xl sm:text-6xl 2xl:text-7xl',
      h1: 'type-heading text-4xl sm:text-5xl 2xl:text-6xl',
      h2: 'type-heading text-3xl sm:text-4xl 2xl:text-5xl',
      h3: 'type-heading-minor text-2xl sm:text-3xl',
      h4: 'type-heading-minor text-lg',
    },
  },
  defaultVariants: { size: 'h2' },
})

type Props = VariantProps<typeof headingVariants> & {
  as?: 'h1' | 'h2' | 'h3' | 'h4' | 'p'
} & HTMLAttributes<'h2'>

const { as: Tag = 'h2', size, class: className, ...rest } = Astro.props
---

<Tag class={cn(headingVariants({ size }), className)} {...rest}>
  <slot />
</Tag>
