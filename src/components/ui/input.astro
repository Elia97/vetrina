---
import type { HTMLAttributes } from 'astro/types'

import { cn } from '@/lib/utils'

type Props = HTMLAttributes<'input'>

const { class: className, ...rest } = Astro.props
---

<input
  class={cn(
    'field-text flex h-(--field-height) w-full rounded-md border border-input bg-background px-3 py-2 placeholder:text-muted-foreground focus-visible:border-(--field-focus-border-color) focus-visible:shadow-(--field-focus-shadow) focus-visible:outline-hidden disabled:cursor-not-allowed disabled:opacity-50',
    className,
  )}
  {...rest}
/>
