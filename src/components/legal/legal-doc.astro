---
import Container from '@/components/ui/container.astro'
import Section from '@/components/ui/section.astro'

import type { LegalDocKind } from '@/lib/legal/documents'

import LegalDocFallback from './legal-doc-fallback.astro'
import { legalProseClass } from './legal-prose'

interface Props {
  kind: LegalDocKind
  /** Ripulito a monte da getLegalDoc: non passare mai HTML non ripulito qui. */
  html: string | null
}

const { kind, html } = Astro.props
---

<Section>
  <Container>
    <div class="mx-auto max-w-3xl">
      {html !== null ? <div class={legalProseClass} set:html={html} /> : <LegalDocFallback {kind} />}
    </div>
  </Container>
</Section>
