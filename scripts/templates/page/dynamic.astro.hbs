---
import Container from '@/components/ui/container.astro'
import Section from '@/components/ui/section.astro'
import MainLayout from '@/layouts/main.astro'

import { useTranslations } from '@/i18n/translate'

export function getStaticPaths() {
  // TODO: derive paths from a collection (see docs/guides/content-collections.md).
  return [{ params: { slug: 'example' } }]
}

const t = useTranslations(Astro.currentLocale)
const { slug } = Astro.params
---

<MainLayout title={slug ?? t('page.{{pageKey}}.title')}>
  <Section>
    <Container>
      <h1 class="text-4xl font-bold tracking-tight text-foreground">{slug}</h1>
    </Container>
  </Section>
</MainLayout>
